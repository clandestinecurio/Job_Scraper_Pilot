  "priority_topics": {
    "_comment": "Roles touching these specialties receive a gold star and become filterable on the dashboard. Each item is a name and JavaScript regex source pair.",
    "terms": [
      [
        "Project & Program Delivery",
        "\\b(project|program|portfolio|workstream|milestone|implementation|deployment|delivery)\\b"
      ],
      [
        "Intelligence & OSINT",
        "\\b(intelligence|OSINT|open[\\s-]?source|investigation|threat intelligence|geopolitical)\\b"
      ],
      [
        "Security & Risk",
        "\\b(security|risk|protective security|asset protection|threat monitoring|crisis response)\\b"
      ],
      [
        "AI & Data Operations",
        "\\b(AI|artificial intelligence|data analytics|SQL|Python|Foundry|data quality)\\b"
      ],
      [
        "Governance & Compliance",
        "\\b(governance|GRC|compliance|assurance|quality assurance|controls)\\b"
      ],
      [
        "Global Operations",
        "\\b(global operations|cross-functional|stakeholder|vendor|service provider|operational readiness)\\b"
      ]
    ]
  },

